DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Manila
# Optional local AI provider (no API key required).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=60
# Optional OpenAI provider. Keep the real key in your ignored local .env only.
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=15
# Optional MySQL/MariaDB configuration. SQLite is used when DB_ENGINE is omitted.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=bsitcrud
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
# Production-only:
# TRUST_X_FORWARDED_PROTO=False
# MYSQL_ROOT_PASSWORD=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# LOG_LEVEL=INFO
